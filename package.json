{
  "name": "deluxe-room-card",
  "version": "0.2.0",
  "description": "Home Assistant Lovelace card: room overview with combined window/cover chips, climate thresholds, light dock, alert bars and rule-based outlines.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests && prettier --check src tests",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "rollup": "^4.28.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
